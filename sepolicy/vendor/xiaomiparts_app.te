r_dir_file(xiaomiparts_app, vendor_sysfs_graphics)
allow xiaomiparts_app vendor_sysfs_graphics:file write;

dontaudit xiaomiparts_app hal_touchfeature_hwservice:hwservice_manager { find };

allow xiaomiparts_app vendor_sysfs_battery_supply:dir search;
allow xiaomiparts_app vendor_sysfs_battery_supply:file r_file_perms;

allow xiaomiparts_app proc_stat:file { read open getattr };

allow xiaomiparts_app vendor_sysfs_kgsl_gpuclk:file { read open getattr };
allow xiaomiparts_app vendor_sysfs_kgsl:file { read open getattr };

allow xiaomiparts_app vendor_sysfs_power_supply:file w_file_perms;
allow xiaomiparts_app vendor_sysfs_battery_supply:file rw_file_perms;
allow xiaomiparts_app vendor_sysfs_battery_supply:dir search;
allow xiaomiparts_app property_socket:sock_file { write };
allow xiaomiparts_app self:netlink_kobject_uevent_socket  { create setopt bind read };
allow xiaomiparts_app init:unix_stream_socket { connectto };
allow xiaomiparts_app exported_system_prop:property_service { set };
allow xiaomiparts_app sysfs_fastcharge:file rw_file_perms;
