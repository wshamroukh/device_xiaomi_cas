
cc_prebuilt_library_shared {
    name: "liblhdc",

    arch: {
        arm: {
            srcs: ["libs/armeabi-v7a/liblhdc.so",],
        },
        arm64: {
            srcs: ["libs/arm64-v8a/liblhdc.so",],
        },
    },

    apex_available: [
        "//apex_available:platform",
        "com.android.btservices",
    ],

    strip: {
        none:true,
    },

    shared_libs: [
        "liblog",
        "libstdc++",
    ],
}


